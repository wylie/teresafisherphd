---
import ShareImage from '../assets/images/share-image.png'
import Favicon from './Favicon.astro';
import { getPageMetadata, siteMetadata } from '../data/site';

const currentPath = Astro.url.pathname;
const page = getPageMetadata(currentPath);
const pageTitle = page?.metaTitle ?? siteMetadata.title;
const pageDescription = page?.description ?? siteMetadata.description;
const canonicalUrl = `${siteMetadata.url}${currentPath}`;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": siteMetadata.ownerName,
  "jobTitle": siteMetadata.jobTitle,
  "url": siteMetadata.url,
  "image": ShareImage.src,
  "sameAs": siteMetadata.sameAs,
  "worksFor": {
    "@type": "Organization",
    "name": siteMetadata.organizationName
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteMetadata.officeLocations[0].streetAddress,
    "addressLocality": siteMetadata.officeLocations[0].addressLocality,
    "addressRegion": siteMetadata.officeLocations[0].addressRegion,
    "postalCode": siteMetadata.officeLocations[0].postalCode,
    "addressCountry": siteMetadata.officeLocations[0].addressCountry
  },
  "telephone": siteMetadata.telephone
};

---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={pageDescription}>
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:image" content={ShareImage.src} />
<meta property="og:image:alt" content="Milkweed Mental Health" />
<meta property="og:description" content={pageDescription} />
<meta property="og:site_name" content="Teresa Fisher, PhD., Milkweed Mental Health" />
<meta property="og:locale" content="en_US" />
<link rel="canonical" href={canonicalUrl} />
<link rel="sitemap" href="/sitemap.xml" />
<title>{pageTitle}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Englebert&family=Outfit:wght@100..900&display=swap" rel="stylesheet">
<script async src="https://www.googletagmanager.com/gtag/js?id=G-3J4GXJ4V1L"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-3J4GXJ4V1L');

  const normalizePath = (path) => {
    if (!path) return '/';
    return path.endsWith('/') ? path : `${path}/`;
  };

  window.trackEvent = (eventName, params = {}) => {
    if (typeof window.gtag !== 'function' || !eventName) return;
    window.gtag('event', eventName, params);
  };

  const trackAnchorClick = (anchor) => {
    if (!anchor) return;

    const href = anchor.getAttribute('href') || '';
    const linkText = (anchor.textContent || '').trim().slice(0, 120);
    const params = {
      page_path: window.location.pathname,
      link_text: linkText || '(no text)',
    };

    const datasetEvent = anchor.dataset.analyticsEvent;
    if (datasetEvent) {
      window.trackEvent(datasetEvent, {
        ...params,
        event_label: anchor.dataset.analyticsLabel || linkText || undefined,
        event_location: anchor.dataset.analyticsLocation || undefined,
        link_url: href || undefined,
      });
      return;
    }

    if (href.startsWith('mailto:')) {
      window.trackEvent('email_click', {
        ...params,
        email_address: href.replace('mailto:', ''),
      });
      return;
    }

    if (href.startsWith('tel:')) {
      window.trackEvent('phone_click', {
        ...params,
        phone_number: href.replace('tel:', ''),
      });
      return;
    }

    let url;
    try {
      url = new URL(href, window.location.href);
    } catch {
      return;
    }

    if (normalizePath(url.pathname) === '/contact/' && url.origin === window.location.origin) {
      window.trackEvent('contact_cta_click', {
        ...params,
        destination_path: '/contact/',
      });
      return;
    }

    if (url.origin !== window.location.origin) {
      window.trackEvent('external_link_click', {
        ...params,
        link_url: url.href,
        link_domain: url.hostname,
      });
    }
  };

  const bindAnalyticsHandlers = () => {
    if (window.__tfAnalyticsBound) return;
    window.__tfAnalyticsBound = true;

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const anchor = target.closest('a');
      trackAnchorClick(anchor);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindAnalyticsHandlers);
  } else {
    bindAnalyticsHandlers();
  }
</script>
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<Favicon />
